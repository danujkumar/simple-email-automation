# Copy to .env and fill in values. Never commit .env.

EMAIL_ADDRESS=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# Optional — defaults shown
# EXCEL_FILE=Email_finder.xlsx
# RESUME_FILE=resume.pdf
# SUBJECT=Application for Data Analyst / Business Analyst Intern and FTE
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# MIN_EMAIL_DELAY_SEC=15
# MAX_EMAIL_DELAY_SEC=30

# Email templates folder (relative to script.py unless absolute)
# EMAIL_TEMPLATE_DIR=templates
# Base filename without extension: loads templates/<name>.html and optional <name>.plain.txt
# EMAIL_TEMPLATE=default

# Used by {{CONTACT_NAME}}, {{CONTACT_PHONE}}, {{CONTACT_EMAIL}} in templates/*.html
# CONTACT_NAME=Your Name
# CONTACT_PHONE=
# CONTACT_EMAIL=

# Any {{YOUR_VAR}} in an HTML/plain template reads YOUR_VAR from the environment.
